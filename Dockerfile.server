# ==========================================
# Backend API Server Dockerfile (Hono + Node.js)
# ==========================================
FROM node:20-alpine AS base
WORKDIR /app

# Install dependencies
COPY reguleran/server/package*.json ./
RUN npm ci --only=production

# Copy source code
COPY reguleran/server/index.js ./

# Set environment
ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

CMD ["node", "index.js"]
